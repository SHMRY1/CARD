<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>My Card</title>
<style>
body {
  font-family: Arial;
  text-align: center;
  background: #f2f2f2;
  padding: 30px;
}

.box {
  background: white;
  padding: 15px;
  margin: 10px auto;
  width: 300px;
  border-radius: 10px;
  box-shadow: 0px 0px 10px #ccc;
  cursor: pointer;
}

.box:hover {
  background: #e6f0ff;
}
</style>
</head>

<body>

<h2>📇 My Contact Card</h2>

<div class="box" onclick="copyText('example@gmail.com')">
📧 Email: example@gmail.com
</div>

<div class="box" onclick="copyText('07701234567')">
📱 Phone: 07701234567
</div>

<div class="box" onclick="copyText('MyPassword123')">
🔐 Password: MyPassword123
</div>

<script>
function copyText(text) {
  navigator.clipboard.writeText(text);
  alert("تم النسخ: " + text);
}
</script>

</body>
</html>
